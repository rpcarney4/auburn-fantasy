# Postgres connection string used at runtime (e.g. a pooled/PgBouncer URL on Supabase).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct (non-pooled) Postgres connection string, used by Prisma Migrate for
# schema changes. On Supabase this is the same host on port 5432.
DIRECT_URL="postgresql://user:password@host:5432/postgres"
